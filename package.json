{
  "name": "@maxischmaxi/maxmux",
  "version": "0.4.1",
  "description": "Modern terminal session manager — a tmux alternative built with TypeScript",
  "type": "module",
  "bin": {
    "maxmux": "./src/index.ts"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky"
  },
  "keywords": [
    "terminal",
    "multiplexer",
    "tmux",
    "session",
    "manager",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxischmaxi/maxmux.git"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "fzf": "^0.5.2",
    "zod": "^4.3.6"
  }
}
